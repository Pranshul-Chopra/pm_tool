{
  "name": "pm-tool",
  "version": "2.1.0",
  "description": "PM Tool — Local-First Project Management Desktop Application",
  "main": "main.js",
  "author": "Pranshul Chopra",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev:ui": "vite",
    "build:ui": "vite build",
    "start": "electron .",
    "build": "npm run build:ui && electron-builder build --win",
    "build:dir": "npm run build:ui && electron-builder build --win --dir"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "clsx": "^2.1.1",
    "electron-updater": "^6.1.7",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "tar": "^7.5.21",
    "http-cache-semantics": "^4.1.1",
    "@electron/get": "^5.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "build": {
    "appId": "dev.pranshulchopra.pmtool",
    "productName": "PM Tool",
    "publish": {
      "provider": "github",
      "owner": "Pranshul-Chopra",
      "repo": "pm_tool",
      "releaseType": "release"
    },
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "../dist/flask",
        "to": "flask",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "icon.ico",
      "artifactName": "PM-Tool-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PM Tool",
      "artifactName": "PM-Tool-Setup-${version}.${ext}"
    }
  }
}
